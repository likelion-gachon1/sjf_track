# ============================================================
# 운영 환경변수 템플릿
#
# 서버에서 ~/mcm/.env 로 복사해 값을 채우세요:
#   cp ~/mcm/sjf_track/deploy/env.production.example ~/mcm/.env
#   nano ~/mcm/.env
#   chmod 600 ~/mcm/.env
#
# ⚠️ 이 파일에 실제 키를 적어 커밋하지 마세요. 채운 .env 는 서버에만 둡니다.
# ============================================================

# 서비스 공개 주소. 프론트/백엔드가 같은 도메인을 씁니다(= CORS 문제 없음).
# deploy/oracle-https.sh 가 이 값을 자동으로 채워줍니다.
# 반드시 https:// 로 시작하고, 끝에 슬래시를 붙이지 마세요.
PUBLIC_BASE_URL=https://mcm-portal.duckdns.org

# OpenAI (무드 판정 /api/analyze-mood, 여권 카피 /api/passport)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Postgres. 비밀번호는 아무 값이나 길게 — 외부에 노출되는 포트가 없습니다.
#   openssl rand -base64 24
POSTGRES_DB=mcm
POSTGRES_USER=mcm
POSTGRES_PASSWORD=change-me-please

# 세션(촬영 결과) 보관 시간
SESSION_TTL_HOURS=24

# DuckDNS (IP 자동 갱신 cron 이 사용)
DUCK_DOMAIN=mcm-portal
DUCK_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
